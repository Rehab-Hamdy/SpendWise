# Copy this file to ".env" and fill in ONE provider. Never commit .env.

# --- Option 1: Groq (free tier) https://console.groq.com/keys
MODEL_NAME=groq:llama-3.3-70b-versatile
GROQ_API_KEY=your_key_here

# --- Option 2: Google Gemini (free tier) https://aistudio.google.com/apikey
# MODEL_NAME=google_genai:gemini-2.0-flash
# GOOGLE_API_KEY=your_key_here

# --- Option 3: OpenRouter (free ":free" models) https://openrouter.ai/keys
# Uses the OpenAI-compatible client:
# MODEL_NAME=openai:meta-llama/llama-3.3-70b-instruct:free
# OPENAI_API_KEY=your_openrouter_key
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- Optional: LangSmith Observability & Tracing (free developer tier)
# Get a free API key at https://smith.langchain.com/
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_key_here
LANGSMITH_PROJECT=SpendWise
# If your account is on the EU region, uncomment:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
